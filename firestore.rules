rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasHomeAccess(data) {
      return signedIn() && (
        (data.authorizedUids is list && request.auth.uid in data.authorizedUids) ||
        (data.authorizedEmails is list && request.auth.token.email != null && request.auth.token.email in data.authorizedEmails)
      );
    }

    match /account_homes/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /nests/{homeCode} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() && hasHomeAccess(request.resource.data);

      allow update: if signedIn() && (
        hasHomeAccess(resource.data) ||
        (
          hasHomeAccess(request.resource.data) &&
          request.resource.data.authorizedUids.hasAll(resource.data.authorizedUids) &&
          request.resource.data.authorizedEmails.hasAll(resource.data.authorizedEmails)
        )
      );
      allow delete: if hasHomeAccess(resource.data);
    }

    match /nests/{homeCode}/history/{revision} {
      allow read, write: if hasHomeAccess(
        get(/databases/$(database)/documents/nests/$(homeCode)).data
      );
    }

    match /milo_daily_updates/{updateId} { allow read, write: if signedIn(); }
    match /notifications/{notificationId} { allow read, write: if signedIn(); }
    match /audit_logs/{logId} { allow read, write: if signedIn(); }
    match /error_logs/{logId} { allow read, write: if signedIn(); }
    match /plantas/{plantId} { allow read, write: if signedIn(); }
    match /plants/{plantId} { allow read, write: if signedIn(); }
    match /closet/{itemId} { allow read, write: if signedIn(); }
    match /closetGarments/{itemId} { allow read, write: if signedIn(); }
    match /closet_garments/{itemId} { allow read, write: if signedIn(); }
    match /prendas/{itemId} { allow read, write: if signedIn(); }
    match /metas/{wishId} { allow read, write: if signedIn(); }
    match /wishes/{wishId} { allow read, write: if signedIn(); }
    match /goals/{wishId} { allow read, write: if signedIn(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
