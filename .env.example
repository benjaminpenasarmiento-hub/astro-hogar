# Gemini
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL
APP_URL="MY_APP_URL"

# Server-side Firestore credential for Vercel.
# NEVER commit the real value to GitHub. Add it only as a Vercel Environment Variable.
# Paste the complete Firebase service-account JSON as a single value.
FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key_id\":\"...\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"...\",\"client_id\":\"...\"}"
